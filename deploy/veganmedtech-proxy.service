# Managed by veganmedtech WORK-0013; do not use for unrelated sites.
[Unit]
Description=VeganMedTech HTTPS demonstration
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=veganmedtech-proxy
Group=veganmedtech-proxy
EnvironmentFile=/etc/veganmedtech/proxy.env
ExecStart=/usr/local/bin/veganmedtech-caddy run --config /etc/veganmedtech/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/veganmedtech-caddy
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
